// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEP
  VET
}

enum Sex {
  M
  F
}

enum UserStatus {
  ACTIVE
  PENDING_INVITE
  DEACTIVATED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String?
  role         Role       @default(RECEP)
  status       UserStatus @default(PENDING_INVITE)
  lastAccessAt DateTime?
  inviteSentAt DateTime?
  createdAt    DateTime   @default(now())

  vet Vet?
}

model Vet {
  id        String    @id @default(uuid())
  crmv      String    @unique
  cpf       String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])

  appointments Appointment[]
  procedures   Procedure[]

  @@index([deletedAt])
}

model PetOwner {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String
  address   String
  cpf       String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  pets      Pet[]

  @@index([deletedAt])
}

model Pet {
  id         String    @id @default(uuid())
  name       String
  species    String
  breed      String
  sex        Sex
  birthDate  DateTime  @db.Date
  weight     Float?
  notes      String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  petOwnerId String
  petOwner   PetOwner  @relation(fields: [petOwnerId], references: [id])

  appointments Appointment[]
  procedures   Procedure[]

  @@index([deletedAt])
}

enum AppointmentStatus {
  ACTIVE
  CANCELLED
  DONE
}

enum ProcedureType {
  CONSULTATION
  RETURN
  VACCINATION
  SURGERY
  EXAM
}

model Appointment {
  id        String            @id @default(uuid())
  type      ProcedureType
  dateTime  DateTime
  createdAt DateTime          @default(now())
  obs       String?
  status    AppointmentStatus @default(ACTIVE)

  petId String
  vetId String

  pet Pet @relation(fields: [petId], references: [id])
  vet Vet @relation(fields: [vetId], references: [id])

  @@index([petId])
  @@index([vetId])
  @@index([dateTime])
}

model Procedure {
  id        String        @id @default(uuid())
  type      ProcedureType
  notes     String        @db.Text
  dateTime  DateTime
  petId     String
  vetId     String
  createdAt DateTime      @default(now())

  pet          Pet             @relation(fields: [petId], references: [id])
  vet          Vet             @relation(fields: [vetId], references: [id])
  extraNotes   ProcedureNote[]
  itemPayments ItemPayment[]

  @@index([type])
  @@index([petId])
  @@index([vetId])
  @@index([dateTime])
}

model ProcedureNote {
  id          String   @id @default(uuid())
  procedureId String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId, createdAt])
}

model Payment {
  id            String   @id @default(uuid())
  paymentMethod String
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  items ItemPayment[]

  @@index([createdAt])
}

model ItemPayment {
  id          String  @id @default(uuid())
  amount      Decimal @db.Decimal(10, 2)
  description String?
  paymentId   String
  procedureId String

  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@unique([paymentId, procedureId])
  @@index([paymentId])
  @@index([procedureId])
}
